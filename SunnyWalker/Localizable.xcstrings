          "stringUnit" : {
            "state" : "translated",
            "value" : "Default: system alarm — breaks silent mode and keeps ringing until turned off (the surest way to wake a child). If the app is swiped away, it may keep ringing and use more battery."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
