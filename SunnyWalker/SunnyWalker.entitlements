<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AlarmKit — the only App Store-compliant way to ring on the lock screen / through Silent
	     mode without keeping a background audio session alive. Requires the App ID to have the
	     AlarmKit capability enabled and the provisioning profile to include it (developer.apple.com
	     → Identifiers → app.rexcode.sunnywalker). If signing fails or requestAuthorization() throws
	     Code=1, the entitlement is not in the signed profile yet. -->
	<key>com.apple.developer.alarmkit</key>
	<true/>
</dict>
</plist>
