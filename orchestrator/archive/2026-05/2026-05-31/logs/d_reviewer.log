  .datePickerStyle(.wheel)\n51\t                .labelsHidden()\n52\t                .frame(maxWidth: .infinity)\n53\t                .padding(.vertical, 8)\n54\t        }\n55\t    }\n56\t\n57\t    private var labelField: some View {\n58\t        WatercolorCard {\n59\t            VStack(alignment: .leading, spacing: 8) {\n60\t                Text(\"鬧鐘名稱\")\n61\t                    .font(GhibliFonts.caption())\n62\t                    .foregroundStyle(GhibliColors.totoroGray)\n63\t                TextField(\"例如：上學囉！\", text: $label)\n64\t                    .font(GhibliFonts.body())\n65\t                    .foregroundStyle(GhibliColors.nightIndigo)\n66\t                    .tint(GhibliColors.leafFresh)\n67\t            }\n68\t            .padding(.horizontal, 20)\n69\t            .padding(.vertical, 16)\n70\t        }\n71\t    }\n72\t\n73\t    private var weekdayPicker: some View {\n74\t        WatercolorCard {\n75\t            VStack(alignment: .leading, spacing: 12) {\n76\t                Text(\"重複日\")\n77\t                    .font(GhibliFonts.caption())\n78\t                    .foregroundStyle(GhibliColors.totoroGray)\n79\t                HStack(spacing: 8) {\n80\t                    ForEach(weekdayLabels, id: \\.0) { num, sym in\n81\t                        WeekdayChip(symbol: sym, isSelected: selectedWeekdays.contains(num)) {\n82\t                            if selectedWeekdays.contains(num) {\n83\t                                selectedWeekdays.remove(num)\n84\t                            } else {\n85\t                                selectedWeekdays.insert(num)\n86\t                            }\n87\t                        }\n88\t                    }\n89\t                }\n90\t            }\n91\t            .padding(.horizontal, 20)\n92\t            .padding(.vertical, 16)\n93\t        }\n94\t    }\n95\t\n96\t    private var saveButton: some View {\n97\t        GhibliButton(\"儲存鬧鐘\", color: GhibliColors.lanternOrange) {\n98\t            saveAlarm()\n99\