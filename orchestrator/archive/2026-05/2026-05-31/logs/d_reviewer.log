(_ weekdays: [Int]) -> String {\n56\t        let set = Set(weekdays)\n57\t        if set == Set(allDays) { return \"daily\" }\n58\t        if set == Set(workdays) { return \"weekdays\" }\n59\t        if set == Set(weekend) { return \"weekends\" }\n60\t        let inv = Dictionary(uniqueKeysWithValues: dayChars.map { ($1, $0) })\n61\t        return weekdays.sorted().compactMap { inv[$0] }.map(String.init).joined()\n62\t    }\n63\t\n64\t    // MARK: - 匯入\n65\t\n66\t    static func parse(_ text: String) -> [ParsedAlarm] {\n67\t        text.components(separatedBy: .newlines).compactMap(parseLine(_:))\n68\t    }\n69\t\n70\t    static func parseLine(_ raw: String) -> ParsedAlarm? {\n71\t        var line = raw.trimmingCharacters(in: .whitespaces)\n72\t        guard !line.isEmpty, !line.hasPrefix(\"#\") else { return nil }\n73\t\n74\t        var enabled = true\n75\t        if line.lowercased().hasSuffix(\"(off)\") {\n76\t            enabled = false\n77\t            line = String(line.dropLast(5)).trimmingCharacters(in: .whitespaces)\n78\t        }\n79\t\n80\t        let parts = line.split(separator: \",\", maxSplits: 2,\n81\t                               omittingEmptySubsequences: false)\n82\t                        .map { $0.trimmingCharacters(in: .whitespaces) }\n83\t        guard parts.count >= 2,\n84\t              let weekdays = parseRepeat(parts[0]),\n85\t              let (h, m) = parseTime(parts[1]) else { return nil }\n86\t\n87\t        let label = parts.count >= 3 ? parts[2] : \"\"\n88\t        return ParsedAlarm(hour: h, minute: m, label: label,\n89\t                           weekdays: weekdays, isEnabled: enabled)\n90\t    }\n91\t\n92\t    private static func parseTime(_ s: String) -> (Int, Int)? {\n93\t        let c = s.split(separator: \":\")\n94\t        guard c.count == 2, let h = Int(c[0]), let m = Int(c[1]),\n95\t              (0...23).contains(h), (0...59).contains(m) else { return nil }\n96\t        return (h, m)\n97\t    }\n98\t\n99\t    private static func parseRepeat(_ s: String) -> [Int]? {\n100\t        switch s.lowercased() {\n101\t        case \"daily\", \"每天\", \"每日\": return allDays\n102\t        case \"weekdays\", \"平日\", \"工作日\": return workdays\n103\t        case \"weekends\", \"週末\", \"周末\": return weekend\n104\t        default:\n105\t            let days = s.compactMap { dayChars[$0] }.sorted()\n106\t            return days.isEmpty ? nil : Array(Set(days)).sorted()\n107\t        }\n108\t    }\n109\t}\n110\t"}]},"parent_tool_use_id":null,"session_id":"9152367c-6882-4536-a02d-e89150f7bc21","uuid":"555d5a56-dfcb-4f68-9c32-7b81a3a55734","timestamp":"2026-05-31T15:39:39.670Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Services/MarkdownAlarmIO.swift","content":"// SunnyWalker — MarkdownAlarmIO.swift  |  鬧鐘設定的 Markdown 匯入 / 匯出\n\nimport Foundation\n\n/// 一行 Markdown 解析後的結果（尚未寫入 SwiftData）。\nstruct ParsedAlarm {\n    var hour: Int\n    var minute: Int\n    var label: String\n    var weekdays: [Int]   // 1=日 … 7=六，對齊 Alarm.weekdays\n    var isEnabled: Bool\n}\n\n/// 鬧鐘的 Markdown 互轉。\n///\n/// 每行格式： `repeat, HH:MM, label`\n/// 例如：\n/// ```\n/// daily, 08:00, go to school\n/// weekdays, 07:00, work\n/// weekends, 09:30, 賴床\n/// 一三五, 06:30, gym            # 自訂星期（用 日一二三四五六）\n/// daily, 13:00, 午睡 (off)      # 結尾加 (off) 代表停用\n/// ```\n/// 以 `#` 開頭或空白的行會被忽略。\n/// 註：資料模型以 weekdays 陣列表示重複，沒有「單次」概念，故不支援 once。\nenum MarkdownAlarmIO {\n\n    static let allDays = [1, 2, 3, 4, 5, 6, 7]\n    static let workdays = [2, 3, 4, 5, 6]\n    static let weekend = [1, 7]\n    private static let dayChars: [Character: Int] = [\n        \"日\": 1, \"一\": 2, \"二\": 3, \"三\": 4, \"四\": 5, \"五\": 6, \"六\": 7\n    ]\n\n    // MARK: - 匯出\n\n    static func export(_ alarms: [Alarm]) -> String {\n        var lines = [\n            \"# SunnyWalker Alarms\",\n            \"# 格式: repeat, HH:MM, label   （停用的鬧鐘結尾會有 (off)）\"\n        ]\n        lines += alarms.map(line(for:))\n        return lines.joined(separator: \"\\n\") + \"\\n\"\n    }\n\n    private static func line(for alarm: Alarm) -> String {\n        let rep = repeatToken(alarm.weekdays)\n        let label = alarm.label.replacingOccurrences(of: \",\", with: \" \")\n        var s = \"\\(rep), \\(alarm.timeString), \\(label)\".trimmingCharacters(in: .whitespaces)\n        if !alarm.isEnabled { s += \" (off)\" }\n        return s\n    }\n\n    private static func repeatToken(_ weekdays: [Int]) -> String {\n        let set = Set(weekdays)\n        if set == Set(allDays) { return \"daily\" }\n        if set == Set(workdays) { return \"weekdays\" }\n        if set == Set(weekend) { return \"weekends\" }\n        let inv = Dictionary(uniqueKeysWithValues: dayChars.map { ($1, $0) })\n        return weekdays.sorted().compactMap { inv[$0] }.map(String.init).joined()\n    }\n\n    // MARK: - 匯入\n\n    static func parse(_ text: String) -> [ParsedAlarm] {\n        text.components(separatedBy: .newlines).compactMap(parseLine(_:))\n    }\n\n    static func parseLine(_ raw: String) -> ParsedAlarm? {\n        var line = raw.trimmingCharacters(in: .whitespaces)\n        guard !line.isEmpty, !line.hasPrefix(\"#\") else { return nil }\n\n        var enabled = true\n        if line.lowercased().hasSuffix(\"(off)\") {\n            enabled = false\n            line = String(line.dropLast(5)).trimmingCharacters(in: .whitespaces)\n        }\n\n        let parts = line.split(separator: \",\", maxSplits: 2,\n                               omittingEmptySubsequences: false)\n                        .map { $0.trimmingCharacters(in: .whitespaces) }\n        guard parts.count >= 2,\n              let weekdays = parseRepeat(parts[0]),\n              let (h, m) = parseTime(parts[1]) else { return nil }\n\n        let label = parts.count >= 3 ? parts[2] : \"\"\n        return ParsedAlarm(hour: h, minute: m, label: label,\n                           weekdays: weekdays, isEnabled: enabled)\n    }\n\n    private static func parseTime(_ s: String) -> (Int, Int)? {\n        let c = s.split(separator: \":\")\n        guard c.count == 2, let h = Int(c[0]), let m = Int(c[1]),\n              (0...23).contains(h), (0...59).contains(m) else { return nil }\n        return (h, m)\n    }\n\n    private static func parseRepeat(_ s: String) -> [Int]? {\n        switch s.lowercased() {\n        case \"daily\", \"每天\", \"每日\": return allDays\n        case \"weekdays\", \"平日\", \"工作日\": return workdays\n        case \"weekends\", \"週末\", \"周末\": return weekend\n        default:\n            let days = s.compactMap { dayChars[$0] }.sorted()\n            return days.isEmpty ? nil : Array(Set(days)).sorted()\n        }\n    }\n}\n","numLines":110,"startLine":1,"totalLines":110}}}
