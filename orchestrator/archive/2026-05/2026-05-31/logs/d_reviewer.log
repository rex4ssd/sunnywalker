uestion(\n51\t            prompt: \"下面哪個數字最大？\",\n52\t            options: [\"763\", \"489\", \"651\"],\n53\t            correct: \"763\"\n54\t        ),\n55\t        GateQuestion(\n56\t            prompt: \"下面哪個數字最大？\",\n57\t            options: [\"819\", \"734\", \"296\"],\n58\t            correct: \"819\"\n59\t        ),\n60\t    ]\n61\t\n62\t    // MARK: 3-digit multiplication (adult-level)\n63\t    private static let multiplicationQuestions: [GateQuestion] = [\n64\t        GateQuestion(\n65\t            prompt: \"127 × 4 = ？\",\n66\t            options: [\"508\", \"438\", \"612\"],\n67\t            correct: \"508\"\n68\t        ),\n69\t        GateQuestion(\n70\t            prompt: \"236 × 3 = ？\",\n71\t            options: [\"708\", \"596\", \"824\"],\n72\t            correct: \"708\"\n73\t        ),\n74\t        GateQuestion(\n75\t            prompt: \"154 × 5 = ？\",\n76\t            options: [\"770\", \"635\", \"912\"],\n77\t            correct: \"770\"\n78\t        ),\n79\t    ]\n80\t}\n81\t\n82\t// MARK: - ParentalGateView\n83\t\n84\tstruct ParentalGateView: View {\n85\t    let onSuccess: () -> Void\n86\t\n87\t    @Environment(\\.dismiss) private var dismiss\n88\t    @State private var question = GateQuestion.random()\n89\t    @State private var wrongCount = 0\n90\t    @State private var shakeOffset: CGFloat = 0\n91\t\n92\t    var body: some View {\n93\t        ZStack {\n94\t            GhibliColors.cloudWhite.ignoresSafeArea()\n95\t            VStack(spacing: 32) {\n96\t                header\n97\t                questionCard\n98\t                optionButtons\n99\t                Spacer()\n100\t                cancelButton\n101\t            }\n102\t            .padding(.horizontal, 28)\n103\t            .padding(.top, 48)\n104\t            .padding(.bottom, 32)\n105\t            .offset(x: shakeOffset)\n106\t        }\n107\t    }\n108\t\n109\t    // MARK: - Subviews\n110\t\n111\t    private var header: some View {\n112\t        VStack(spacing: 6) {\n113\