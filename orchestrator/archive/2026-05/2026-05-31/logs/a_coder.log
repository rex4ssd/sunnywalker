{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HDxFwwcW3uaqivXR2q3c62","type":"tool_result","content":"1\t// SunnyWalker — AlarmScheduler.swift  |  Day 2  |  UNUserNotificationCenter wrapper\n2\t\n3\timport UserNotifications\n4\timport Foundation\n5\t\n6\t@MainActor\n7\tfinal class AlarmScheduler {\n8\t    static let shared = AlarmScheduler()\n9\t    private init() {}\n10\t\n11\t    // Schedule one notification request per active weekday so repeats honour the weekdays array.\n12\t    func schedule(alarm: Alarm) async throws {\n13\t        let center = UNUserNotificationCenter.current()\n14\t\n15\t        // Remove any stale requests (all 7 possible weekday slots + bare UUID fallback)\n16\t        let staleIDs = (1...7).map { \"\\(alarm.id.uuidString)-\\($0)\" } + [alarm.id.uuidString]\n17\t        center.removePendingNotificationRequests(withIdentifiers: staleIDs)\n18\t\n19\t        let content = UNMutableNotificationContent()\n20\t        content.title = \"起床囉！\"\n21\t        content.body = alarm.recordingName.isEmpty\n22\t            ? \"早安！☀️ 快來聽鬧鐘\"\n23\t            : \"點開來聽：\\(alarm.recordingName)\"\n24\t        content.sound = .default\n25\t        content.categoryIdentifier = \"SUNNYWAKE_ALARM\"\n26\t        content.userInfo = [\"alarmID\": alarm.id.uuidString]\n27\t\n28\t        for weekday in alarm.weekdays {\n29\t            var components = DateComponents()\n30\t            components.hour = alarm.hour\n31\t            components.minute = alarm.minute\n32\t            components.weekday = weekday  // 1=Sun … 7=Sat, matches Alarm.weekdays convention\n33\t\n34\t            let trigger = UNCalendarNotificationTrigger(dateMatching: components, repeats: true)\n35\t            let request = UNNotificationRequest(\n36\t                identifier: \"\\(alarm.id.uuidString)-\\(weekday)\",\n37\t                content: content,\n38\t                trigger: trigger)\n39\t\n40\t            try await center.add(request)\n41\t        }\n42\t    }\n43\t\n44\t    func cancel(_ alarmID: UUID) {\n45\t        let identifiers = (1...7).map { \"\\(alarmID.uuidString)-\\($0)\" } + [alarmID.uuidString]\n46\t        UNUserNotificationCenter.current()\n47\t            .removePendingNotificationRequests(withIdentifiers: identifiers)\n48\t    }\n49\t\n50\t    // Convenience: schedule if enabled, cancel if disabled.\n51\t    func syncWithModel(alarm: Alarm) async throws {\n52\t        if alarm.isEnabled {\n53\t            try await schedule(alarm: alarm)\n54\t        } else {\n55\t            cancel(alarm.id)\n56\t        }\n57\t    }\n58\t}\n59\t"}]},"parent_tool_use_id":null,"session_id":"c69117f8-9d9f-4a88-a3d2-542b6ec1037a","uuid":"fb54bc0b-851d-4e9b-ace5-bf242682664c","timestamp":"2026-05-30T17:25:12.383Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Services/AlarmScheduler.swift","content":"// SunnyWalker — AlarmScheduler.swift  |  Day 2  |  UNUserNotificationCenter wrapper\n\nimport UserNotifications\nimport Foundation\n\n@MainActor\nfinal class AlarmScheduler {\n    static let shared = AlarmScheduler()\n    private init() {}\n\n    // Schedule one notification request per active weekday so repeats honour the weekdays array.\n    func schedule(alarm: Alarm) async throws {\n        let center = UNUserNotificationCenter.current()\n\n        // Remove any stale requests (all 7 possible weekday slots + bare UUID fallback)\n        let staleIDs = (1...7).map { \"\\(alarm.id.uuidString)-\\($0)\" } + [alarm.id.uuidString]\n        center.removePendingNotificationRequests(withIdentifiers: staleIDs)\n\n        let content = UNMutableNotificationContent()\n        content.title = \"起床囉！\"\n        content.body = alarm.recordingName.isEmpty\n            ? \"早安！☀️ 快來聽鬧鐘\"\n            : \"點開來聽：\\(alarm.recordingName)\"\n        content.sound = .default\n        content.categoryIdentifier = \"SUNNYWAKE_ALARM\"\n        content.userInfo = [\"alarmID\": alarm.id.uuidString]\n\n        for weekday in alarm.weekdays {\n            var components = DateComponents()\n            components.hour = alarm.hour\n            components.minute = alarm.minute\n            components.weekday = weekday  // 1=Sun … 7=Sat, matches Alarm.weekdays convention\n\n            let trigger = UNCalendarNotificationTrigger(dateMatching: components, repeats: true)\n            let request = UNNotificationRequest(\n                identifier: \"\\(alarm.id.uuidString)-\\(weekday)\",\n                content: content,\n                trigger: trigger)\n\n            try await center.add(request)\n        }\n    }\n\n    func cancel(_ alarmID: UUID) {\n        let identifiers = (1...7).map { \"\\(alarmID.uuidString)-\\($0)\" } + [alarmID.uuidString]\n        UNUserNotificationCenter.current()\n            .removePendingNotificationRequests(withIdentifiers: identifiers)\n    }\n\n    // Convenience: schedule if enabled, cancel if disabled.\n    func syncWithModel(alarm: Alarm) async throws {\n        if alarm.isEnabled {\n            try await schedule(alarm: alarm)\n        } else {\n            cancel(alarm.id)\n        }\n    }\n}\n","numLines":59,"startLine":1,"totalLines":59}}}
