foregroundStyle(GhibliColors.lanternOrange)\n54\t            } else if hasRecording {\n55\t                Text(\"錄音完成 ✅\")\n56\t                    .font(GhibliFonts.title(24))\n57\t                    .foregroundStyle(GhibliColors.forestDeep)\n58\t            } else {\n59\t                Text(\"請說一段起床的話給孩子聽\")\n60\t                    .font(GhibliFonts.title(22))\n61\t                    .foregroundStyle(GhibliColors.nightIndigo)\n62\t                    .multilineTextAlignment(.center)\n63\t            }\n64\t            if let error = recordingError {\n65\t                Text(error)\n66\t                    .font(GhibliFonts.caption())\n67\t                    .foregroundStyle(GhibliColors.lanternOrange)\n68\t                    .multilineTextAlignment(.center)\n69\t            }\n70\t        }\n71\t    }\n72\t\n73\t    private var controlSection: some View {\n74\t        VStack(spacing: 16) {\n75\t            if audioRecorder.isRecording {\n76\t                GhibliButton(\"停止錄音 ⏹\", color: GhibliColors.forestDeep) {\n77\t                    stopRecording()\n78\t                }\n79\t            } else {\n80\t                GhibliButton(hasRecording ? \"重新錄音 🎙️\" : \"開始錄音 🎙️\",\n81\t                             color: GhibliColors.lanternOrange) {\n82\t                    startRecording()\n83\t                }\n84\t                if hasRecording {\n85\t                    GhibliButton(\"試聽 ▶️\", color: GhibliColors.skyBlue) {\n86\t                        playRecording()\n87\t                    }\n88\t                }\n89\t            }\n90\t        }\n91\t    }\n92\t\n93\t    // MARK: - Actions\n94\t\n95\t    private func startRecording() {\n96\t        recordingError = nil\n97\t        audioPlayer.stop()\n98\t        do {\n99\t            try audioRecorder.start(named: alarm.id.uuidString)\n100\t        } catch {\n101\t            recordingError = \"無法開始錄音：\\(error.localizedDescription)\"\n102\t        }\n103\t    }\n104\t\n105\t    private func stopR