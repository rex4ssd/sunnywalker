em(size: 56))\n                Text(\"新增鬧鐘\")\n                    .font(GhibliFonts.title(24))\n                    .foregroundStyle(GhibliColors.nightIndigo)\n                Text(\"設定畫面將在 Day 4 完成\")\n                    .font(GhibliFonts.caption())\n                    .foregroundStyle(GhibliColors.totoroGray)\n            }\n            .padding()\n            .navigationBarTitleDisplayMode(.inline)\n            .toolbar {\n                ToolbarItem(placement: .cancellationAction) {\n                    Button(\"關閉\") { dismiss() }\n                }\n            }\n        }\n    }\n}\n\n#Preview {\n    HomeView()\n        .modelContainer(for: Alarm.self, inMemory: true)\n}\n","structuredPatch":[{"oldStart":81,"oldLines":7,"newStart":81,"newLines":7,"lines":["         }","         .padding(24)","         .sheet(isPresented: $showingAddAlarm) {","-            AddAlarmPlaceholder()","+            AlarmEditorView()","         }","     }"," }"]}],"userModified":false,"replaceAll":false}}
