 }\n46\t        }\n47\t    }\n48\t\n49\t    // MARK: - Subviews\n50\t\n51\t    private var timePicker: some View {\n52\t        WatercolorCard {\n53\t            DatePicker(\"\", selection: $selectedTime, displayedComponents: [.hourAndMinute])\n54\t                .datePickerStyle(.wheel)\n55\t                .labelsHidden()\n56\t                .frame(maxWidth: .infinity)\n57\t                .padding(.vertical, 8)\n58\t        }\n59\t    }\n60\t\n61\t    private var labelField: some View {\n62\t        WatercolorCard {\n63\t            VStack(alignment: .leading, spacing: 8) {\n64\t                Text(\"鬧鐘名稱\")\n65\t                    .font(GhibliFonts.caption())\n66\t                    .foregroundStyle(GhibliColors.totoroGray)\n67\t                TextField(\"例如：上學囉！\", text: $label)\n68\t                    .font(GhibliFonts.body())\n69\t                    .foregroundStyle(GhibliColors.nightIndigo)\n70\t                    .tint(GhibliColors.leafFresh)\n71\t            }\n72\t            .padding(.horizontal, 20)\n73\t            .padding(.vertical, 16)\n74\t        }\n75\t    }\n76\t\n77\t    private var weekdayPicker: some View {\n78\t        WatercolorCard {\n79\t            VStack(alignment: .leading, spacing: 12) {\n80\t                Text(\"重複日\")\n81\t                    .font(GhibliFonts.caption())\n82\t                    .foregroundStyle(GhibliColors.totoroGray)\n83\t                HStack(spacing: 8) {\n84\t                    ForEach(weekdayLabels, id: \\.0) { num, sym in\n85\t                        WeekdayChip(symbol: sym, isSelected: selectedWeekdays.contains(num)) {\n86\t                            if selectedWeekdays.contains(num) {\n87\t                                selectedWeekdays.remove(num)\n88\t                            } else {\n89\t                                selectedWeekdays.insert(num)\n90\t                            }\n91\t                        }\n92\t                    }\n93\t                }\n94\t            }\n95\t            .padding(.horizontal, 20)\n96\t            .padding(.vertical, 16)\n97\t        }\n98\t    }\n99\t\n100\t    private var recordingRow: some View {\n101\t        WatercolorCard {\n102\t            Button { showingRecording = true } label: {\n103\t                HStack(spacing: 14) {\n104\t                    Image(systemName: tempAlarm.recordingName.isEmpty ? \"mic\" : \"mic.fill\")\n105\t                        .font(.system(size: 20))\n106\t                        .foregroundStyle(\n107\t                            tempAlarm.recordingName.isEmpty\n108\t                                ? GhibliColors.totoroGray.opacity(0.6)\n109\t                                : GhibliColors.leafFresh\n110\t                        )\n111\t                        .frame(width: 28)\n112\t                    VStack(alignment: .leading, spacing: 2) {\n113\t                        Text(\"錄音喚醒語\")\n114\t                            .font(GhibliFonts.caption())\n115\t                            .foregroundStyle(GhibliColors.nightIndigo)\n116\t                        Text(tempAlarm.recordingName.isEmpty ? \"尚未錄音\" : \"已錄音 ✅\")\n117\t                            .font(GhibliFonts.caption(14))\n118\t                            .foregroundStyle(\n119\t                                tempAlarm.recordingName.isEmpty\n120\t                                    ? GhibliColors.totoroGray\n121\t                                    : GhibliColors.forestDeep\n122\t                            )\n123\t                    }\n124\t                    Spacer()\n125\t                    Image(systemName: \"chevron.right\")\n126\t                        .font(.system(size: 13, weight: .semibold))\n127\t                        .foregroundStyle(GhibliColors.totoroGray.opacity(0.5))\n128\t                }\n129\t                .padding(.horizontal, 20)\n130\t                .padding(.vertical, 16)\n131\t            }\n132\t            .buttonStyle(.plain)\n133\t        }\n134\t        .sheet(isPresented: $showingRecording) {\n135\t            RecordingView(alarm: tempAlarm)\n136\t        }\n137\t    }\n138\t\n139\t    private var saveButton: some View {\n140\t        GhibliButton(\"儲存鬧鐘\", color: GhibliColors.lanternOrange) {\n141\t            saveAlarm()\n142\t        }\n143\t        .disabled(isSaving)\n144\t    }\n145\t\n146\t    // MARK: - Save logic\n147\t\n148\t    private func saveAlarm() {\n149\t        isSaving = true\n150\t        let comps = Calendar.current.dateComponents([.hour, .minute], from: selectedTime)\n151\t        let trimmed = label.trimmingCharacters(in: .whitespaces)\n152\t        // Reuse tempAlarm so the stable UUID matches any recording already saved to disk\n153\t        tempAlarm.label = trimmed.isEmpty ? \"起床囉\" : trimmed\n154\t        tempAlarm.hour = comps.hour ?? 7\n155\t        tempAlarm.minute = comps.minute ?? 0\n156\t        tempAlarm.weekdays = selectedWeekdays.isEmpty ? [2, 3, 4, 5, 6] : Array(selectedWeekdays).sorted()\n157\t        modelContext.insert(tempAlarm)\n158\t        Task {\n159\t            try? await AlarmScheduler.shared.schedule(alarm: tempAlarm)\n160\t            await MainActor.run {\n161\t                isSaving = false\n162\t                dismiss()\n163\t            }\n164\t        }\n165\t    }\n166\t}\n167\t\n168\t// MARK: - WeekdayChip\n169\t\n170\tprivate struct WeekdayChip: View {\n171\t    let symbol: String\n172\t    let isSelected: Bool\n173\t    let onTap: () -> Void\n174\t\n175\t    var body: some View {\n176\t        Button(action: onTap) {\n177\t            Text(symbol)\n178\t                .font(GhibliFonts.caption(14))\n179\t                .foregroundStyle(isSelected ? .white : GhibliColors.totoroGray)\n180\t                .frame(width: 36, height: 36)\n181\t                .background(\n182\t                    Circle()\n183\t                        .fill(isSelected ? GhibliColors.leafFresh : GhibliColors.totoroGray.opacity(0.12))\n184\t                )\n185\t        }\n186\t        .ghibliButtonStyle()\n187\t    }\n188\t}\n189\t\n190\t#Preview {\n191\t    AlarmEditorView()\n192\t        .modelContainer(for: Alarm.self, inMemory: true)\n193\t}\n194\t"}]},"parent_tool_use_id":null,"session_id":"764b7222-f4f5-44d6-855e-324d3471572b","uuid":"68194471-c58b-420e-8047-1242bdd83900","timestamp":"2026-05-31T15:31:31.208Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Views/Settings/AlarmEditorView.swift","content":"// SunnyWalker — AlarmEditorView.swift  |  Day 3  |  add alarm editor\n\nimport SwiftUI\nimport SwiftData\n\nstruct AlarmEditorView: View {\n    @Environment(\\.modelContext) private var modelContext\n    @Environment(\\.dismiss) private var dismiss\n\n    // tempAlarm carries a stable UUID so RecordingView writes to the right file\n    @State private var tempAlarm = Alarm(label: \"起床囉\", hour: 7, minute: 0)\n    @State private var selectedTime = Date()\n    @State private var label = \"起床囉\"\n    @State private var selectedWeekdays: Set<Int> = [2, 3, 4, 5, 6]  // Mon–Fri default\n    @State private var isSaving = false\n    @State private var showingRecording = false\n\n    private let weekdayLabels: [(Int, String)] = [\n        (1, \"日\"), (2, \"一\"), (3, \"二\"), (4, \"三\"), (5, \"四\"), (6, \"五\"), (7, \"六\")\n    ]\n\n    var body: some View {\n        NavigationStack {\n            ZStack {\n                GhibliColors.cloudWhite.ignoresSafeArea()\n                ScrollView {\n                    VStack(spacing: 24) {\n                        timePicker\n                        labelField\n                        weekdayPicker\n                        recordingRow\n                        saveButton\n                    }\n                    .padding(24)\n                }\n            }\n            .navigationTitle(\"新增鬧鐘\")\n            .navigationBarTitleDisplayMode(.inline)\n            .toolbar {\n                ToolbarItem(placement: .cancellationAction) {\n                    Button(\"取消\") { dismiss() }\n                        .font(GhibliFonts.caption())\n                        .foregroundStyle(GhibliColors.totoroGray)\n                }\n            }\n        }\n    }\n\n    // MARK: - Subviews\n\n    private var timePicker: some View {\n        WatercolorCard {\n            DatePicker(\"\", selection: $selectedTime, displayedComponents: [.hourAndMinute])\n                .datePickerStyle(.wheel)\n                .labelsHidden()\n                .frame(maxWidth: .infinity)\n                .padding(.vertical, 8)\n        }\n    }\n\n    private var labelField: some View {\n        WatercolorCard {\n            VStack(alignment: .leading, spacing: 8) {\n                Text(\"鬧鐘名稱\")\n                    .font(GhibliFonts.caption())\n                    .foregroundStyle(GhibliColors.totoroGray)\n                TextField(\"例如：上學囉！\", text: $label)\n                    .font(GhibliFonts.body())\n                    .foregroundStyle(GhibliColors.nightIndigo)\n                    .tint(GhibliColors.leafFresh)\n            }\n            .padding(.horizontal, 20)\n            .padding(.vertical, 16)\n        }\n    }\n\n    private var weekdayPicker: some View {\n        WatercolorCard {\n            VStack(alignment: .leading, spacing: 12) {\n                Text(\"重複日\")\n                    .font(GhibliFonts.caption())\n                    .foregroundStyle(GhibliColors.totoroGray)\n                HStack(spacing: 8) {\n                    ForEach(weekdayLabels, id: \\.0) { num, sym in\n                        WeekdayChip(symbol: sym, isSelected: selectedWeekdays.contains(num)) {\n                            if selectedWeekdays.contains(num) {\n                                selectedWeekdays.remove(num)\n                            } else {\n                                selectedWeekdays.insert(num)\n                            }\n                        }\n                    }\n                }\n            }\n            .padding(.horizontal, 20)\n            .padding(.vertical, 16)\n        }\n    }\n\n    private var recordingRow: some View {\n        WatercolorCard {\n            Button { showingRecording = true } label: {\n                HStack(spacing: 14) {\n                    Image(systemName: tempAlarm.recordingName.isEmpty ? \"mic\" : \"mic.fill\")\n                        .font(.system(size: 20))\n                        .foregroundStyle(\n                            tempAlarm.recordingName.isEmpty\n                                ? GhibliColors.totoroGray.opacity(0.6)\n                                : GhibliColors.leafFresh\n                        )\n                        .frame(width: 28)\n                    VStack(alignment: .leading, spacing: 2) {\n                        Text(\"錄音喚醒語\")\n                            .font(GhibliFonts.caption())\n                            .foregroundStyle(GhibliColors.nightIndigo)\n                        Text(tempAlarm.recordingName.isEmpty ? \"尚未錄音\" : \"已錄音 ✅\")\n                            .font(GhibliFonts.caption(14))\n                            .foregroundStyle(\n                                tempAlarm.recordingName.isEmpty\n                                    ? GhibliColors.totoroGray\n                                    : GhibliColors.forestDeep\n                            )\n                    }\n                    Spacer()\n                    Image(systemName: \"chevron.right\")\n                        .font(.system(size: 13, weight: .semibold))\n                        .foregroundStyle(GhibliColors.totoroGray.opacity(0.5))\n                }\n                .padding(.horizontal, 20)\n                .padding(.vertical, 16)\n            }\n            .buttonStyle(.plain)\n        }\n        .sheet(isPresented: $showingRecording) {\n            RecordingView(alarm: tempAlarm)\n        }\n    }\n\n    private var saveButton: some View {\n        GhibliButton(\"儲存鬧鐘\", color: GhibliColors.lanternOrange) {\n            saveAlarm()\n        }\n        .disabled(isSaving)\n    }\n\n    // MARK: - Save logic\n\n    private func saveAlarm() {\n        isSaving = true\n        let comps = Calendar.current.dateComponents([.hour, .minute], from: selectedTime)\n        let trimmed = label.trimmingCharacters(in: .whitespaces)\n        // Reuse tempAlarm so the stable UUID matches any recording already saved to disk\n        tempAlarm.label = trimmed.isEmpty ? \"起床囉\" : trimmed\n        tempAlarm.hour = comps.hour ?? 7\n        tempAlarm.minute = comps.minute ?? 0\n        tempAlarm.weekdays = selectedWeekdays.isEmpty ? [2, 3, 4, 5, 6] : Array(selectedWeekdays).sorted()\n        modelContext.insert(tempAlarm)\n        Task {\n            try? await AlarmScheduler.shared.schedule(alarm: tempAlarm)\n            await MainActor.run {\n                isSaving = false\n                dismiss()\n            }\n        }\n    }\n}\n\n// MARK: - WeekdayChip\n\nprivate struct WeekdayChip: View {\n    let symbol: String\n    let isSelected: Bool\n    let onTap: () -> Void\n\n    var body: some View {\n        Button(action: onTap) {\n            Text(symbol)\n                .font(GhibliFonts.caption(14))\n                .foregroundStyle(isSelected ? .white : GhibliColors.totoroGray)\n                .frame(width: 36, height: 36)\n                .background(\n                    Circle()\n                        .fill(isSelected ? GhibliColors.leafFresh : GhibliColors.totoroGray.opacity(0.12))\n                )\n        }\n        .ghibliButtonStyle()\n    }\n}\n\n#Preview {\n    AlarmEditorView()\n        .modelContainer(for: Alarm.self, inMemory: true)\n}\n","numLines":194,"startLine":1,"totalLines":194}}}
