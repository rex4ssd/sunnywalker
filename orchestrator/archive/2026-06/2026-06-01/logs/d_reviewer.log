{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UTmK1FPnsb3hV6zrHUyb7A","type":"tool_result","content":"1\t// SunnyWalker — SpeechRecognizer.swift  |  Day 5  |  on-device SFSpeechRecognizer + AVAudioEngine\n2\t\n3\timport Speech\n4\timport AVFoundation\n5\timport Foundation\n6\t\n7\t@MainActor\n8\tfinal class SpeechRecognizer: ObservableObject {\n9\t    @Published var recognizedText = \"\"\n10\t    @Published var matchedKeyword: String?\n11\t\n12\t    private let recognizer: SFSpeechRecognizer?\n13\t    private let audioEngine = AVAudioEngine()\n14\t    private var request: SFSpeechAudioBufferRecognitionRequest?\n15\t    private var task: SFSpeechRecognitionTask?\n16\t    private var isListening = false\n17\t\n18\t    private let keywords = [\"我起床了\", \"好的\", \"知道了\", \"起床囉\"]\n19\t\n20\t    init() {\n21\t        recognizer = SFSpeechRecognizer(locale: Locale(identifier: \"zh-TW\"))\n22\t    }\n23\t\n24\t    func startListening(onMatch: @escaping (String) -> Void, onFailure: (() -> Void)? = nil) throws {\n25\t        guard !isListening else { return }\n26\t        guard let recognizer, recognizer.isAvailable else {\n27\t            throw NSError(domain: \"SpeechRecognizer\", code: -1,\n28\t                          userInfo: [NSLocalizedDescriptionKey: \"語音辨識器不可用\"])\n29\t        }\n30\t        guard recognizer.supportsOnDeviceRecognition else {\n31\t            throw NSError(domain: \"SpeechRecognizer\", code: -2,\n32\t                          userInfo: [NSLocalizedDescriptionKey: \"此裝置不支援離線辨識\"])\n33\t        }\n34\t\n35\t        recognizedText = \"\"\n36\t        matchedKeyword = nil\n37\t\n38\t        request = SFSpeechAudioBufferRecognitionRequest()\n39\t        request?.requiresOnDeviceRecognition = true  // 100% offline — never remove\n40\t        request?.shouldReportPartialResults = true\n41\t\n42\t        let inputNode = audioEngine.inputNode\n43\t        let format = inputNode.outputFormat(forBus: 0)\n44\t        inputNode.installTap(onBus: 0, bufferSize: 1024, format: format) { [weak self] buffer, _ in\n45\t            self?.request?.append(buffer)\n46\t        }\n47\t\n48\t        audioEngine.prepare()\n49\t        try audioEngine.start()\n50\t        isListening = true\n51\t\n52\t        task = recognizer.recognitionTask(with: request!) { [weak self] result, error in\n53\t            guard let self else { return }\n54\t            if let error {\n55\t                print(\"SpeechRecognizer: recognition error — \\(error.localizedDescription)\")\n56\t                self.stop()\n57\t                onFailure?()\n58\t                return\n59\t            }\n60\t            guard let text = result?.bestTranscription.formattedString else { return }\n61\t            self.recognizedText = text\n62\t\n63\t            if let hit = self.keywords.first(where: { text.contains($0) }) {\n64\t                self.matchedKeyword = hit\n65\t                onMatch(hit)\n66\t                self.stop()\n67\t            }\n68\t        }\n69\t    }\n70\t\n71\t    func stop() {\n72\t        guard isListening else { return }\n73\t        isListening = false\n74\t        audioEngine.stop()\n75\t        audioEngine.inputNode.removeTap(onBus: 0)\n76\t        request?.endAudio()\n77\t        task?.cancel()\n78\t        request = nil\n79\t        task = nil\n80\t    }\n81\t}\n82\t"}]},"parent_tool_use_id":null,"session_id":"ccd063ae-11e4-4b75-af1f-fa5a323246a9","uuid":"785ee700-2b5a-440d-9b55-e8b0c4dd17b1","timestamp":"2026-06-01T02:48:01.027Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Services/SpeechRecognizer.swift","content":"// SunnyWalker — SpeechRecognizer.swift  |  Day 5  |  on-device SFSpeechRecognizer + AVAudioEngine\n\nimport Speech\nimport AVFoundation\nimport Foundation\n\n@MainActor\nfinal class SpeechRecognizer: ObservableObject {\n    @Published var recognizedText = \"\"\n    @Published var matchedKeyword: String?\n\n    private let recognizer: SFSpeechRecognizer?\n    private let audioEngine = AVAudioEngine()\n    private var request: SFSpeechAudioBufferRecognitionRequest?\n    private var task: SFSpeechRecognitionTask?\n    private var isListening = false\n\n    private let keywords = [\"我起床了\", \"好的\", \"知道了\", \"起床囉\"]\n\n    init() {\n        recognizer = SFSpeechRecognizer(locale: Locale(identifier: \"zh-TW\"))\n    }\n\n    func startListening(onMatch: @escaping (String) -> Void, onFailure: (() -> Void)? = nil) throws {\n        guard !isListening else { return }\n        guard let recognizer, recognizer.isAvailable else {\n            throw NSError(domain: \"SpeechRecognizer\", code: -1,\n                          userInfo: [NSLocalizedDescriptionKey: \"語音辨識器不可用\"])\n        }\n        guard recognizer.supportsOnDeviceRecognition else {\n            throw NSError(domain: \"SpeechRecognizer\", code: -2,\n                          userInfo: [NSLocalizedDescriptionKey: \"此裝置不支援離線辨識\"])\n        }\n\n        recognizedText = \"\"\n        matchedKeyword = nil\n\n        request = SFSpeechAudioBufferRecognitionRequest()\n        request?.requiresOnDeviceRecognition = true  // 100% offline — never remove\n        request?.shouldReportPartialResults = true\n\n        let inputNode = audioEngine.inputNode\n        let format = inputNode.outputFormat(forBus: 0)\n        inputNode.installTap(onBus: 0, bufferSize: 1024, format: format) { [weak self] buffer, _ in\n            self?.request?.append(buffer)\n        }\n\n        audioEngine.prepare()\n        try audioEngine.start()\n        isListening = true\n\n        task = recognizer.recognitionTask(with: request!) { [weak self] result, error in\n            guard let self else { return }\n            if let error {\n                print(\"SpeechRecognizer: recognition error — \\(error.localizedDescription)\")\n                self.stop()\n                onFailure?()\n                return\n            }\n            guard let text = result?.bestTranscription.formattedString else { return }\n            self.recognizedText = text\n\n            if let hit = self.keywords.first(where: { text.contains($0) }) {\n                self.matchedKeyword = hit\n                onMatch(hit)\n                self.stop()\n            }\n        }\n    }\n\n    func stop() {\n        guard isListening else { return }\n        isListening = false\n        audioEngine.stop()\n        audioEngine.inputNode.removeTap(onBus: 0)\n        request?.endAudio()\n        task?.cancel()\n        request = nil\n        task = nil\n    }\n}\n","numLines":82,"startLine":1,"totalLines":82}}}
