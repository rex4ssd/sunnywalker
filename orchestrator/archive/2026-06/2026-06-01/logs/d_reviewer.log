     let a = VoiceClip(name: \"A\", fileName: \"a.m4a\")\n55\t        let b = VoiceClip(name: \"B\", fileName: \"b.m4a\")\n56\t        XCTAssertNotEqual(a.id, b.id)\n57\t    }\n58\t}\n59\t\n60\t@MainActor\n61\tfinal class AudioPlayerTests: XCTestCase {\n62\t\n63\t    func testInitialIsPlayingIsFalse() {\n64\t        let player = AudioPlayer()\n65\t        XCTAssertFalse(player.isPlaying)\n66\t    }\n67\t\n68\t    func testStopWhenIdleKeepsIsPlayingFalse() {\n69\t        let player = AudioPlayer()\n70\t        player.stop()\n71\t        XCTAssertFalse(player.isPlaying)\n72\t    }\n73\t\n74\t    /// Verifies that the AVAudioPlayerDelegate callback resets isPlaying.\n75\t    /// If the audioPlayerDidFinishPlaying implementation is removed, this test fails.\n76\t    func testAudioPlayerIsPlayingAutoResets() {\n77\t        let player = AudioPlayer()\n78\t        // Simulate that playback was started by setting the published flag directly.\n79\t        player.isPlaying = true\n80\t        // Call the delegate method directly (as AVFoundation would when playback ends).\n81\t        player.audioPlayerDidFinishPlaying(AVAudioPlayer(), successfully: true)\n82\t        // isPlaying should reset synchronously via Task @MainActor (we're already on MainActor).\n83\t        // Give the Task a tick to execute.\n84\t        let exp = expectation(description: \"isPlaying resets\")\n85\t        Task { @MainActor in\n86\t            // After one async hop the Task body has run\n87\t            XCTAssertFalse(player.isPlaying, \"isPlaying must be false after playback ends\")\n88\t            exp.fulfill()\n89\t        }\n90\t        wait(for: [exp], timeout: 1.0)\n91\t    }\n92\t}\n93\t\n94\tfinal class AlarmSoundTests: XCTestCase {\n95\t\n96\t    func testSoundFileNameDefault() {\n97\t        let alarm = Alarm(label: \"Morning\", hour: 7, minute: 0)\n98\t        XCTAssertEqual(alarm.soundFileName, \"totoro_breath.caf\")\n99\t    }\n100\t\n101\t    func testSoundFileNameIsMutable() {\n102\t        let alarm = Alarm(label: \"Morning\", hour: 7, minute: 0)\n103\t        alarm.soundFileName = \"leaf_rustle.caf\"\n104\t        XCTAssertEqual(alarm.soundFileName, \"leaf_rustle.caf\")\n105\t    }\n106\t}\n107\t\n108\tfinal class WakePhraseTests: XCTestCase {\n109\t\n110\t    func testDefaultKeywordsNotEmpty() {\n111\t        XCTAssertFalse(WakePhrase.defaultKeywords.isEmpty)\n112\t    }\n113\t\n114\t    func testPrimaryKeywordPresent() {\n115\t        XCTAssertTrue(WakePhrase.texts.contains(\"我起床了\"))\n116\t    }\n117\t\n118\t    func testAllKeywordsZhTW() {\n119\t        XCTAssertTrue(WakePhrase.defaultKeywords.allSatisfy { $0.locale == \"zh-TW\" })\n120\t    }"}]},"parent_tool_use_id":null,"session_id":"162e4724-11c2-4fa8-9f0d-e11f72ce045c","uuid":"17a60845-9ffc-468f-8077-238d72018192","timestamp":"2026-05-31T17:50:37.260Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalkerTests/SunnyWalkerTests.swift","content":"// SunnyWalker — SunnyWalkerTests.swift  |  Day 1  |  smoke + Alarm model tests\n\nimport XCTest\nimport AVFoundation\n@testable import SunnyWalker\n\nfinal class SunnyWalkerSmokeTests: XCTestCase {\n    func testTrueIsTrue() {\n        XCTAssertTrue(true, \"bootstrap smoke test\")\n    }\n}\n\nfinal class AlarmModelTests: XCTestCase {\n\n    func testTimeStringZeroPadded() {\n        let alarm = Alarm(label: \"Test\", hour: 7, minute: 5)\n        XCTAssertEqual(alarm.timeString, \"07:05\")\n    }\n\n    func testTimeStringFullHour() {\n        let alarm = Alarm(label: \"Test\", hour: 13, minute: 0)\n        XCTAssertEqual(alarm.timeString, \"13:00\")\n    }\n\n    func testDefaultWeekdaysIsMonToFri() {\n        let alarm = Alarm(label: \"Test\", hour: 7, minute: 30)\n        XCTAssertEqual(alarm.weekdays, [2, 3, 4, 5, 6])\n    }\n\n    func testDefaultIsEnabled() {\n        let alarm = Alarm(label: \"Test\", hour: 7, minute: 30)\n        XCTAssertTrue(alarm.isEnabled)\n    }\n\n    func testWeekdaySymbolsMonToFri() {\n        let alarm = Alarm(label: \"Test\", hour: 7, minute: 30)\n        XCTAssertEqual(alarm.weekdaySymbols, [\"一\", \"二\", \"三\", \"四\", \"五\"])\n    }\n}\n\nfinal class VoiceClipTests: XCTestCase {\n\n    func testFormattedDurationZero() {\n        let clip = VoiceClip(name: \"Test\", fileName: \"test.m4a\", duration: 0)\n        XCTAssertEqual(clip.formattedDuration, \"--:--\")\n    }\n\n    func testFormattedDurationMinutesSeconds() {\n        let clip = VoiceClip(name: \"Test\", fileName: \"test.m4a\", duration: 90)\n        XCTAssertEqual(clip.formattedDuration, \"1:30\")\n    }\n\n    func testUniqueIDs() {\n        let a = VoiceClip(name: \"A\", fileName: \"a.m4a\")\n        let b = VoiceClip(name: \"B\", fileName: \"b.m4a\")\n        XCTAssertNotEqual(a.id, b.id)\n    }\n}\n\n@MainActor\nfinal class AudioPlayerTests: XCTestCase {\n\n    func testInitialIsPlayingIsFalse() {\n        let player = AudioPlayer()\n        XCTAssertFalse(player.isPlaying)\n    }\n\n    func testStopWhenIdleKeepsIsPlayingFalse() {\n        let player = AudioPlayer()\n        player.stop()\n        XCTAssertFalse(player.isPlaying)\n    }\n\n    /// Verifies that the AVAudioPlayerDelegate callback resets isPlaying.\n    /// If the audioPlayerDidFinishPlaying implementation is removed, this test fails.\n    func testAudioPlayerIsPlayingAutoResets() {\n        let player = AudioPlayer()\n        // Simulate that playback was started by setting the published flag directly.\n        player.isPlaying = true\n        // Call the delegate method directly (as AVFoundation would when playback ends).\n        player.audioPlayerDidFinishPlaying(AVAudioPlayer(), successfully: true)\n        // isPlaying should reset synchronously via Task @MainActor (we're already on MainActor).\n        // Give the Task a tick to execute.\n        let exp = expectation(description: \"isPlaying resets\")\n        Task { @MainActor in\n            // After one async hop the Task body has run\n            XCTAssertFalse(player.isPlaying, \"isPlaying must be false after playback ends\")\n            exp.fulfill()\n        }\n        wait(for: [exp], timeout: 1.0)\n    }\n}\n\nfinal class AlarmSoundTests: XCTestCase {\n\n    func testSoundFileNameDefault() {\n        let alarm = Alarm(label: \"Morning\", hour: 7, minute: 0)\n        XCTAssertEqual(alarm.soundFileName, \"totoro_breath.caf\")\n    }\n\n    func testSoundFileNameIsMutable() {\n        let alarm = Alarm(label: \"Morning\", hour: 7, minute: 0)\n        alarm.soundFileName = \"leaf_rustle.caf\"\n        XCTAssertEqual(alarm.soundFileName, \"leaf_rustle.caf\")\n    }\n}\n\nfinal class WakePhraseTests: XCTestCase {\n\n    func testDefaultKeywordsNotEmpty() {\n        XCTAssertFalse(WakePhrase.defaultKeywords.isEmpty)\n    }\n\n    func testPrimaryKeywordPresent() {\n        XCTAssertTrue(WakePhrase.texts.contains(\"我起床了\"))\n    }\n\n    func testAllKeywordsZhTW() {\n        XCTAssertTrue(WakePhrase.defaultKeywords.allSatisfy { $0.locale == \"zh-TW\" })\n    }","numLines":120,"startLine":1,"totalLines":294}}}
