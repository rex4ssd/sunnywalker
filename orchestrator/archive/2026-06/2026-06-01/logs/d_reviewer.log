ode\n44\t        let format = inputNode.outputFormat(forBus: 0)\n45\t        inputNode.installTap(onBus: 0, bufferSize: 1024, format: format) { [weak self] buffer, _ in\n46\t            self?.request?.append(buffer)\n47\t        }\n48\t\n49\t        audioEngine.prepare()\n50\t        try audioEngine.start()\n51\t        isListening = true\n52\t\n53\t        // Fires onFailure after listeningTimeout seconds if the child says random words\n54\t        // and no keyword match occurs (the primary spec §8 failure scenario, not just system errors).\n55\t        timeoutTask = Task { [weak self] in\n56\t            try? await Task.sleep(for: .seconds(listeningTimeout))\n57\t            guard let self, !Task.isCancelled, self.isListening else { return }\n58\t            self.stop()\n59\t            onFailure?()\n60\t        }\n61\t\n62\t        task = recognizer.recognitionTask(with: request!) { [weak self] result, error in\n63\t            guard let self else { return }\n64\t            if let error {\n65\t                print(\"SpeechRecognizer: recognition error — \\(error.localizedDescription)\")\n66\t                self.stop()\n67\t                onFailure?()\n68\t                return\n69\t            }\n70\t            guard let text = result?.bestTranscription.formattedString else { return }\n71\t            self.recognizedText = text\n72\t\n73\t            if let hit = self.keywords.first(where: { text.contains($0) }) {\n74\t                self.matchedKeyword = hit\n75\t                onMatch(hit)\n76\t                self.stop()\n77\t            }\n78\t        }\n79\t    }\n80\t\n81\t    func stop() {\n82\t        guard isListening else { return }\n83\t        isListening = false\n84\t        timeoutTask?.cancel()\n85\t        timeoutTask = nil\n86\t        audioEngine.stop()\n87\t        audioEngine.inputNode.removeTap(onBus: 0)\n88\t        request?.endAudio()\n89\t        task?.cancel()\n90\t        request = nil\n91\t        task = nil\n92\t    }\n93\t}\n