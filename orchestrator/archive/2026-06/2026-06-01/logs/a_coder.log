{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014jS5PAAreKGYpgBq8fq1Hp","type":"tool_result","content":"1\t// SunnyWalker — AlarmScheduler.swift  |  Day 2  |  UNUserNotificationCenter wrapper\n2\t\n3\timport UserNotifications\n4\timport Foundation\n5\t\n6\t@MainActor\n7\tfinal class AlarmScheduler {\n8\t    static let shared = AlarmScheduler()\n9\t    private init() {}\n10\t\n11\t    // Schedule one notification request per active weekday so repeats honour the weekdays array.\n12\t    func schedule(alarm: Alarm) async throws {\n13\t        let center = UNUserNotificationCenter.current()\n14\t\n15\t        // Remove any stale requests (all 7 possible weekday slots + bare UUID fallback)\n16\t        let staleIDs = (1...7).map { \"\\(alarm.id.uuidString)-\\($0)\" } + [alarm.id.uuidString]\n17\t        center.removePendingNotificationRequests(withIdentifiers: staleIDs)\n18\t\n19\t        let content = UNMutableNotificationContent()\n20\t        content.title = \"起床囉！\"\n21\t        content.body = alarm.recordingName.isEmpty\n22\t            ? \"早安！☀️ 快來聽鬧鐘\"\n23\t            : \"點開來聽：\\(alarm.recordingName)\"\n24\t        content.sound = UNNotificationSound(\n25\t            named: UNNotificationSoundName(rawValue: alarm.soundFileName)\n26\t        )\n27\t        content.categoryIdentifier = \"SUNNYWAKE_ALARM\"\n28\t        content.userInfo = [\"alarmID\": alarm.id.uuidString]\n29\t\n30\t        for weekday in alarm.weekdays {\n31\t            var components = DateComponents()\n32\t            components.hour = alarm.hour\n33\t            components.minute = alarm.minute\n34\t            components.weekday = weekday  // 1=Sun … 7=Sat, matches Alarm.weekdays convention\n35\t\n36\t            let trigger = UNCalendarNotificationTrigger(dateMatching: components, repeats: true)\n37\t            let request = UNNotificationRequest(\n38\t                identifier: \"\\(alarm.id.uuidString)-\\(weekday)\",\n39\t                content: content,\n40\t                trigger: trigger)\n41\t\n42\t            try await center.add(request)\n43\t        }\n44\t    }\n45\t\n46\t    func cancel(_ alarmID: UUID) {\n47\t        let identifiers = (1...7).map { \"\\(alarmID.uuidString)-\\($0)\" } + [alarmID.uuidString]\n48\t        UNUserNotificationCenter.current()\n49\t            .removePendingNotificationRequests(withIdentifiers: identifiers)\n50\t    }\n51\t\n52\t    // Convenience: schedule if enabled, cancel if disabled.\n53\t    func syncWithModel(alarm: Alarm) async throws {\n54\t        if alarm.isEnabled {\n55\t            try await schedule(alarm: alarm)\n56\t        } else {\n57\t            cancel(alarm.id)\n58\t        }\n59\t    }\n60\t}\n61\t"}]},"parent_tool_use_id":null,"session_id":"5dcf3e0e-d2d8-44ea-b9cb-4fa6b866e978","uuid":"3ec9976e-c46c-443f-83b7-05c44a7307ac","timestamp":"2026-05-31T16:14:14.424Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Services/AlarmScheduler.swift","content":"// SunnyWalker — AlarmScheduler.swift  |  Day 2  |  UNUserNotificationCenter wrapper\n\nimport UserNotifications\nimport Foundation\n\n@MainActor\nfinal class AlarmScheduler {\n    static let shared = AlarmScheduler()\n    private init() {}\n\n    // Schedule one notification request per active weekday so repeats honour the weekdays array.\n    func schedule(alarm: Alarm) async throws {\n        let center = UNUserNotificationCenter.current()\n\n        // Remove any stale requests (all 7 possible weekday slots + bare UUID fallback)\n        let staleIDs = (1...7).map { \"\\(alarm.id.uuidString)-\\($0)\" } + [alarm.id.uuidString]\n        center.removePendingNotificationRequests(withIdentifiers: staleIDs)\n\n        let content = UNMutableNotificationContent()\n        content.title = \"起床囉！\"\n        content.body = alarm.recordingName.isEmpty\n            ? \"早安！☀️ 快來聽鬧鐘\"\n            : \"點開來聽：\\(alarm.recordingName)\"\n        content.sound = UNNotificationSound(\n            named: UNNotificationSoundName(rawValue: alarm.soundFileName)\n        )\n        content.categoryIdentifier = \"SUNNYWAKE_ALARM\"\n        content.userInfo = [\"alarmID\": alarm.id.uuidString]\n\n        for weekday in alarm.weekdays {\n            var components = DateComponents()\n            components.hour = alarm.hour\n            components.minute = alarm.minute\n            components.weekday = weekday  // 1=Sun … 7=Sat, matches Alarm.weekdays convention\n\n            let trigger = UNCalendarNotificationTrigger(dateMatching: components, repeats: true)\n            let request = UNNotificationRequest(\n                identifier: \"\\(alarm.id.uuidString)-\\(weekday)\",\n                content: content,\n                trigger: trigger)\n\n            try await center.add(request)\n        }\n    }\n\n    func cancel(_ alarmID: UUID) {\n        let identifiers = (1...7).map { \"\\(alarmID.uuidString)-\\($0)\" } + [alarmID.uuidString]\n        UNUserNotificationCenter.current()\n            .removePendingNotificationRequests(withIdentifiers: identifiers)\n    }\n\n    // Convenience: schedule if enabled, cancel if disabled.\n    func syncWithModel(alarm: Alarm) async throws {\n        if alarm.isEnabled {\n            try await schedule(alarm: alarm)\n        } else {\n            cancel(alarm.id)\n        }\n    }\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
