()\n50\t                }\n51\t                .padding(.horizontal, 40)\n52\t                .padding(.bottom, 56)\n53\t            }\n54\t        }\n55\t        .onAppear {\n56\t            wiggle = true\n57\t            startAudio()\n58\t            speechTask = Task {\n59\t                try? await Task.sleep(for: .seconds(5))\n60\t                guard !Task.isCancelled else { return }\n61\t                do {\n62\t                    try speechRecognizer.startListening { keyword in\n63\t                        print(\"SpeechRecognizer: matched '\\(keyword)' — triggering wake-up\")\n64\t                        handleWakeUp()\n65\t                    }\n66\t                } catch {\n67\t                    print(\"SpeechRecognizer: failed to start — \\(error.localizedDescription)\")\n68\t                }\n69\t            }\n70\t        }\n71\t        .onDisappear {\n72\t            speechTask?.cancel()\n73\t            audioPlayer.stop()\n74\t            speechRecognizer.stop()\n75\t        }\n76\t        .fullScreenCover(isPresented: $showingReward, onDismiss: { dismiss() }) {\n77\t            RewardView()\n78\t        }\n79\t    }\n80\t\n81\t    private func handleWakeUp() {\n82\t        speechTask?.cancel()\n83\t        audioPlayer.stop()\n84\t        speechRecognizer.stop()\n85\t        showingReward = true\n86\t    }\n87\t\n88\t    private func startAudio() {\n89\t        let recordingName = alarm?.recordingName ?? \"\"\n90\t        if !recordingName.isEmpty {\n91\t            let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]\n92\t            let url = docs.appendingPathComponent(\"Recordings/\\(recordingName).m4a\")\n93\t            if FileManager.default.fileExists(atPath: url.path) {\n94\t                audioPlayer.play(url: url)\n95\t                return\n96\t            }\n97\t        }\n98\t\n99\t        let soundName = alarm?.soundFileName ?? \"totoro_breath.caf\"\n100\t        if let bundleURL = Bundle.main.url(forResource: soundName, withExtension: nil) {\n101\t            audioPlayer.play(url: bundleURL)\n102\t        } else {\n103\t            print(\"AudioPlayer: no recording — skipping playback\")\n104\t        }\n105\t    }\n106\t}\n107\t\n108\t#Preview {\n109\t    AlarmRingView()\n110\t}\n111\t"}]},"parent_tool_use_id":null,"session_id":"bf2951c0-7aa5-41b5-92a9-f15c57da5d6a","uuid":"2222c1cb-03e5-4cc8-882f-6cfb86e03180","timestamp":"2026-05-31T16:59:00.268Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/lion/Documents/SunnyWalker/SunnyWalker/Views/Alarm/AlarmRingView.swift","content":"// SunnyWalker — AlarmRingView.swift  |  Day 5  |  alarm ring with real speech + task-cancellation fix\n\nimport SwiftUI\n\nstruct AlarmRingView: View {\n    var alarm: Alarm? = nil\n\n    @Environment(\\.dismiss) private var dismiss\n    @StateObject private var audioPlayer = AudioPlayer()\n    @StateObject private var speechRecognizer = SpeechRecognizer()\n    @State private var wiggle = false\n    @State private var showingReward = false\n    @State private var speechTask: Task<Void, Never>?  // stored so handleWakeUp can cancel it\n\n    private var scene: DaytimeScene {\n        DaytimeScene.current(hour: Calendar.current.component(.hour, from: Date()))\n    }\n\n    var body: some View {\n        ZStack {\n            LinearGradient(\n                colors: scene.gradientColors,\n                startPoint: .top,\n                endPoint: .bottom\n            )\n            .ignoresSafeArea()\n\n            CloudBackground()\n\n            VStack(spacing: 0) {\n                Spacer()\n\n                TotoroAvatar()\n                    .rotationEffect(.degrees(wiggle ? 10 : -10), anchor: .bottom)\n                    .animation(\n                        .easeInOut(duration: 0.35).repeatForever(autoreverses: true),\n                        value: wiggle\n                    )\n                    .padding(.bottom, 32)\n\n                Text(\"該起床囉！☀️\")\n                    .font(GhibliFonts.title(28))\n                    .foregroundStyle(scene.clockTextColor)\n                    .padding(.bottom, 56)\n\n                Spacer()\n\n                GhibliButton(\"我起床了！\", color: GhibliColors.lanternOrange) {\n                    handleWakeUp()\n                }\n                .padding(.horizontal, 40)\n                .padding(.bottom, 56)\n            }\n        }\n        .onAppear {\n            wiggle = true\n            startAudio()\n            speechTask = Task {\n                try? await Task.sleep(for: .seconds(5))\n                guard !Task.isCancelled else { return }\n                do {\n                    try speechRecognizer.startListening { keyword in\n                        print(\"SpeechRecognizer: matched '\\(keyword)' — triggering wake-up\")\n                        handleWakeUp()\n                    }\n                } catch {\n                    print(\"SpeechRecognizer: failed to start — \\(error.localizedDescription)\")\n                }\n            }\n        }\n        .onDisappear {\n            speechTask?.cancel()\n            audioPlayer.stop()\n            speechRecognizer.stop()\n        }\n        .fullScreenCover(isPresented: $showingReward, onDismiss: { dismiss() }) {\n            RewardView()\n        }\n    }\n\n    private func handleWakeUp() {\n        speechTask?.cancel()\n        audioPlayer.stop()\n        speechRecognizer.stop()\n        showingReward = true\n    }\n\n    private func startAudio() {\n        let recordingName = alarm?.recordingName ?? \"\"\n        if !recordingName.isEmpty {\n            let docs = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]\n            let url = docs.appendingPathComponent(\"Recordings/\\(recordingName).m4a\")\n            if FileManager.default.fileExists(atPath: url.path) {\n                audioPlayer.play(url: url)\n                return\n            }\n        }\n\n        let soundName = alarm?.soundFileName ?? \"totoro_breath.caf\"\n        if let bundleURL = Bundle.main.url(forResource: soundName, withExtension: nil) {\n            audioPlayer.play(url: bundleURL)\n        } else {\n            print(\"AudioPlayer: no recording — skipping playback\")\n        }\n    }\n}\n\n#Preview {\n    AlarmRingView()\n}\n","numLines":111,"startLine":1,"totalLines":111}}}
