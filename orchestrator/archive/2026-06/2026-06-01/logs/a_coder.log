        }\n90\t        .fullScreenCover(item: $firingAlarm) { alarm in\n91\t            AlarmRingView(alarm: alarm)\n92\t        }\n93\t    }\n94\t\n95\t    // Handles the killed-state case: AppDelegate stored the alarm ID before HomeView was ready.\n96\t    // Accepts an injected delegate to allow unit testing without UIApplicationMain.\n97\t    func checkPendingAlarm(delegate: AppDelegate? = UIApplication.shared.delegate as? AppDelegate) {\n98\t        guard let delegate, let id = delegate.pendingAlarmID else { return }\n99\t        delegate.pendingAlarmID = nil\n100\t        guard let uuid = UUID(uuidString: id),\n101\t              let alarm = alarms.first(where: { $0.id == uuid }) else { return }\n102\t        firingAlarm = alarm\n103\t    }\n104\t\n105\t    // MARK: - Background\n106\t\n107\t    private var background: some View {\n108\t        LinearGradient(\n109\t            colors: scene.gradientColors,\n110\t            startPoint: .top,\n111\t            endPoint: .bottom\n112\t        )\n113\t        .ignoresSafeArea()\n114\t    }\n115\t\n116\t    // MARK: - Clock header\n117\t\n118\t    private func clockHeader(fontSize: CGFloat = 76) -> some View {\n119\t        VStack(spacing: 6) {\n120\t            Text(currentTime, format: .dateTime.hour().minute())\n121\t                .font(GhibliFonts.clock(fontSize))\n122\t                .foregroundStyle(scene.clockTextColor)\n123\t                .contentTransition(.numericText())\n124\t                .animation(.easeInOut(duration: 0.3), value: currentTime)\n125\t\n126\t            Text(currentTime, format: .dateTime.weekday(.wide).month().day())\n127\t                .font(GhibliFonts.subtitle())\n128\t                .foregroundStyle(scene.clockTextColor.opacity(0.7))\n129\t        }\n130\t    }\n131\t\n132\t    // MARK: - FAB buttons (add alarm + IO)\n133\t\n134\t    private var addButton: some View {\n135\t        VStack(spacing: 16) {\n136\t            // IO / export button — gated behind parental gat